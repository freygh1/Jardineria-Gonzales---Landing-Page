---
const { encabezado } = Astro.props;
---

<div tabindex={0} class="collapse h-max collapse-arrow border border-amber-800 w-[100%] bg-linear-90 bg-[#dcfff3]">
  <div class="collapse-title text-3xl font-medium">
    <h4 class="ml-20 ">{encabezado}</h4>
  </div>
  <div class="collapse-content">
    <ul class="*:list-disc max-sm:*:ml-10 md:*:ml-20 lg:*:ml-40  md:*:text-2xl lg:*:text-3xl">
      <slot />
    </ul>
  </div>
</div>
