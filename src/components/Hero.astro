---
import CotizacionBtn from "./CotizacionBtn.astro";
---

<div class="flex flex-wrap justify-between items-center mx-[5vw] gap-6">
  <div class="max-w-[500px]">
    <h1 class="text-[90px] mb-5">Servicios de Jardinería Gonzales</h1>
    <p class="text-2xl">
      Pioneros en servicios de jardinería en Republica Dominicana, manteniendo la vanguardia, eficiencia e innovación desde 1980.
    </p>
  </div>
  <div class="max-w-[500px]">
    <h2 class="text-[40px] mb-7">Descuidar un patio, es restarle vida a tu hogar, por eso te ayudamos a restaurarlo!</h2>
    <CotizacionBtn />
  </div>
</div>
