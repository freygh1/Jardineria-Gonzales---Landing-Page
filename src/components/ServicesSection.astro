---
import Services from "../components/Services.astro";
import CotizacionBtn from "../components/CotizacionBtn.astro";
---

<section class="z-10 absolute h-full w-full flex flex-col justify-center items-center gap-10">
  <h2 class="text-6xl bg-white p-2.5 w-full text-center border-y border-amber-600">Nuestros servicios:</h2>
  <div class="divider before:bg-amber-700 after:bg-amber-700">Puedes armar un plan con los siguientes servicios</div>
  <Services encabezado="Maintenance">
    <li>Corte de césped y poda.</li>
    <li>Riego y revisión de sistemas.</li>
    <li>Limpieza y sustitución de plantas dañadas.</li>
  </Services>
  <Services encabezado="Softscaping">
    <li>Plantación y siembra (flores, césped, arbustos, árboles).</li>
    <li>Fertilización y control de plagas.</li>
    <li>Jardines especiales (verticales, techos verdes).</li>
  </Services>
  <Services encabezado="Hardscaping">
    <li>Caminos, bordes y áreas decorativas (piedras, grava, terrazas).</li>
    <li>Fuentes, estanques e iluminación de jardines.</li>
    <li>Cercas, pérgolas y muros.</li>
  </Services>
  <CotizacionBtn />
</section>
