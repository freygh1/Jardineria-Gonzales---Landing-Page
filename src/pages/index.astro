---
import "../styles/global.css";
const businessName = "Jardinería Gonzales";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AboutUsSection from "../components/AboutUsSection.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Somos Jardinería Gonzales, expertos en servicios de jardineria en Republica Dominicana con mas de 15 años de experiencia. Contactanos al 8x9-123-4567"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{businessName}</title>
	</head>
	<body class="min-h-screen">
		<Header>
			<Hero />
		</Header>
		<main>
			<AboutUsSection />
		</main>
	</body>
</html>
